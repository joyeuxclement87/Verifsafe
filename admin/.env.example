# VerifSafe — admin panel (separate app, port 3001)
#
# Copy this file and fill in real values:
#   cp .env.example .env.local
# .env.local is git-ignored and never committed.
#
# The admin panel is its own Next.js app in admin/ using the SAME Supabase
# project as the public website. It only reads the three Supabase vars below —
# no Sanity, no Telegram.
#
# Full setup guide: docs/supabase.md

# ── Supabase (project settings → API) ─────────────────────────────
# Public values — safe in the browser (RLS enforced server-side).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. NEVER in the browser. Used by lib/supabase/admin.ts for
# privileged server operations (enquiries/gallery). Add SUPABASE_SERVICE_ROLE_KEY
# to your deployment's server-side env.
SUPABASE_SERVICE_ROLE_KEY=
