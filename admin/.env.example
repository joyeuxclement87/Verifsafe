# VerifSafe — admin panel (port 3001, separate Next.js app in admin/)
#
# The admin app reads env from ITS OWN working directory — not the repo root.
# Copy this file into the admin folder and fill in the real values:
#   cd admin
#   cp .env.example .env.local
# .env.local is git-ignored and never committed.
#
# Signals the same Supabase project as the public website. Admins authenticate
# via Supabase Auth; RLS (is_admin()) protects every table and Storage bucket.
# See docs/supabase.md for the complete setup.

# ── Supabase ──────────────────────────────────────────────────────
# Project settings → API. Public values — safe in the browser (RLS enforced).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Project settings → API → `service_role` secret key. SERVER-ONLY — never
# exposed to the browser. Required by admin server actions that manage
# enquiries, gallery rows and Storage/media (admin/lib/supabase/admin.ts).
SUPABASE_SERVICE_ROLE_KEY=
