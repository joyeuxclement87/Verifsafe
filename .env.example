# VerifSafe — public website (port 3000)
#
# Copy this file and fill in your real values:
#   cp .env.example .env.local
# .env.local is git-ignored and never committed.
#
# Supabase powers enquiries, the gallery and the media library (RLS-enforced).
# See docs/supabase.md for the full setup, migrations and security model.

# ── Supabase ──────────────────────────────────────────────────────
# Project settings → API. Public values — safe in the browser (RLS enforced).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Project settings → API → `service_role` secret key. SERVER-ONLY — NEVER
# exposed to the browser. Used for privileged operations (lib/supabase/admin.ts).
# Add SUPABASE_SERVICE_ROLE_KEY (without the NEXT_PUBLIC_ prefix) to your
# deployment's server-side env.
SUPABASE_SERVICE_ROLE_KEY=

# ── Certificate Verification ──────────────────────────────────────
# Permanent public verification URL encoded into certificate QR codes.
# Must be a permanent HTTPS domain (never localhost, *.vercel.app, or a PDF/Storage URL).
# Defaults to https://verifsafe.com/verify when omitted.
NEXT_PUBLIC_CERTIFICATE_VERIFICATION_URL=https://verifsafe.com/verify

# ── Sanity (legacy CMS, being migrated to Supabase) ──────────────
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
NEXT_PUBLIC_SANITY_API_VERSION=
SANITY_API_WRITE_TOKEN=

# ── Telegram notifications (website enquiries & certificate alerts) ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
